{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(VBoxManage:*)",
      "Bash(bash:*)",
      "Bash(bundle:*)",
      "Bash(cargo:*)",
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(done:*)",
      "Bash(duckdb:*)",
      "Bash(fd:*)",
      "Bash(file:*)",
      "Bash(find:*)",
      "Bash(for:*)",
      "Bash(git ls-remote:*)",
      "Bash(grep:*)",
      "Bash(just:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mise:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(qemu-system-x86_64:*)",
      "Bash(rake:*)",
      "Bash(rm:*)",
      "Bash(rustc:*)",
      "Bash(tee:*)",
      "Bash(tree:*)",
      "Bash(uv:*)",
      "Bash(vagrant --version:*)",
      "Bash(xargs:*)",
      "Bash(wc:*)",
      "Read(~/.codex/AGENTS.md)",
      "WebFetch(domain:ansible.readthedocs.io)",
      "WebFetch(domain:crates.io)",
      "WebFetch(domain:docs.ansible.com)",
      "WebFetch(domain:docs.propelauth.com)",
      "WebFetch(domain:docs.rs)",
      "WebFetch(domain:duckdb.org)",
      "WebFetch(domain:ducklake.select)",
      "WebFetch(domain:forgejo.org)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:grafana.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:tailscale.com)",
      "WebSearch"
    ]
  },
  "model": "fable[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message 'Claude Code needs your attention' -title 'Claude Code' -sound 'default'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "terminal-notifier -message 'Claude finished' -title 'Claude Code' -sound 'default'"
          }
        ]
      }
    ]
  },
  "feedbackDrafts": "off",
  "alwaysThinkingEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark"
}
